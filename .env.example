# ==============================================================================
# MAHUM.LK — LOCAL ENVIRONMENT VARIABLES
# Replace every <PLACEHOLDER> below with your own real, free-tier credentials.
# This file is gitignored — never commit real secrets.
# ==============================================================================

# --- Neon (Postgres) ----------------------------------------------------------
# Create a free project at https://neon.tech
# DATABASE_URL  = the "Pooled connection" string (used by the running app)
# DIRECT_URL    = the "Direct connection" string (used only for migrations)
DATABASE_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_POOLED_HOST>/<NEON_DB_NAME>?sslmode=require"
DIRECT_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_DIRECT_HOST>/<NEON_DB_NAME>?sslmode=require"

# --- JWT Authentication --------------------------------------------------------
# Generate strong random values with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Cloudinary (free tier image storage/CDN) ----------------------------------
# Create a free account at https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME="<CLOUDINARY_CLOUD_NAME>"
CLOUDINARY_API_KEY="<CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<CLOUDINARY_API_SECRET>"

# --- Google Gemini (free tier chatbot) -----------------------------------------
# Create a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<GEMINI_API_KEY>"
GEMINI_MODEL="gemini-2.5-flash"

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
