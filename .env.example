# ==============================================================================
# MAHUM.LK — LOCAL ENVIRONMENT VARIABLES
# Replace every <PLACEHOLDER> below with your own real, free-tier credentials.
# This file is gitignored — never commit real secrets.
# ==============================================================================

# --- Neon (Postgres) ----------------------------------------------------------
# Create a free project at https://neon.tech
# DATABASE_URL  = the "Pooled connection" string (used by the running app)
# DIRECT_URL    = the "Direct connection" string (used only for migrations)
DATABASE_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_POOLED_HOST>/<NEON_DB_NAME>?sslmode=require"
DIRECT_URL="postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_DIRECT_HOST>/<NEON_DB_NAME>?sslmode=require"

# --- JWT Authentication --------------------------------------------------------
# Generate strong random values with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Cloudinary (free tier image storage/CDN) ----------------------------------
# Create a free account at https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME="<CLOUDINARY_CLOUD_NAME>"
CLOUDINARY_API_KEY="<CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<CLOUDINARY_API_SECRET>"

# --- Google Gemini (free tier chatbot) -----------------------------------------
# Create a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<GEMINI_API_KEY>"
GEMINI_MODEL="gemini-flash-lite-latest"

# --- PayHere (free sandbox card payment gateway) -------------------------------
# Sign up for a free account at https://www.payhere.lk -> Settings -> Domains &
# Credentials. Every new merchant account automatically has a Sandbox mode
# with its own Merchant ID + Merchant Secret (no card/KYC approval needed to
# test). PAYHERE_MODE="sandbox" keeps all card payments on the test gateway —
# switch to "live" only after PayHere approves your account for real payments.
PAYHERE_MERCHANT_ID="<PAYHERE_SANDBOX_MERCHANT_ID>"
PAYHERE_MERCHANT_SECRET="<PAYHERE_SANDBOX_MERCHANT_SECRET>"
PAYHERE_MODE="sandbox"

# OPTIONAL but recommended for local development: lets the app actively ask
# PayHere "what happened to this payment?" right when the customer returns,
# instead of only waiting for the notify_url webhook above (which can't
# reach localhost). Create these under PayHere Dashboard -> Settings ->
# "Create App" / API access (a different pair of credentials than your
# Merchant ID/Secret). Leave as placeholders to skip this — the app still
# works fully once deployed to a public URL, via the webhook alone.
PAYHERE_APP_ID="<PAYHERE_APP_ID>"
PAYHERE_APP_SECRET="<PAYHERE_APP_SECRET>"

# !! ACADEMIC / LOCAL-DEMO ONLY — DO NOT ENABLE IN PRODUCTION OR WITH REAL
# MONEY !! When "true", the /checkout/payhere/return page is allowed to mark
# an order "Paid" purely because the browser landed there — with NO
# verification against PayHere at all (no webhook, no OAuth check). This
# exists only so this can be demoed on localhost without a public URL/ngrok.
# It is NOT secure: a signed-in customer could visit their own
# /checkout/payhere/return?order_id=... link directly and mark an unpaid
# order "Paid" without ever paying. Leave as "false" for anything real.
PAYHERE_TRUST_RETURN_REDIRECT="false"

# --- App ------------------------------------------------------------------------
# Must be a publicly reachable URL (not localhost) for PayHere's notify_url
# webhook to ever reach your server — see README for local testing with a
# tunnel (e.g. ngrok) if you want to test the full payment confirmation flow
# before deploying.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
